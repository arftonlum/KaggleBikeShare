# Define x values
library(tidyverse)
x_vals <- c(0,1,2,3,4,5,6,7)
# Compute pmf values (use dbinom)
pmf_values <- dbinom(x_vals,30,.6)
# Plot the pmf
ggplot(mapping = aes(x=x_vals,y=pmf_values)) +
geom_line(color = "blue") +
labs(x = "X Values",y = "Density", title = "Binomial pmf")
# Compute pmf values (use dbinom)
pmf_values <- dbinom(x_vals,7,.6)
# Plot the pmf
ggplot(mapping = aes(x=x_vals,y=pmf_values)) +
geom_line(color = "blue") +
labs(x = "X Values",y = "Density", title = "Binomial pmf")
