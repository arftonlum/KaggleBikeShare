pmf_values <- dbinom(x_vals,7,.6)
# Plot the pmf
ggplot(mapping = aes(x=x_vals,y=pmf_values)) +
geom_point(color = "blue") +
labs(x = "X Values",y = "Density", title = "Binomial pmf")
# Plot the pmf
ggplot(mapping = aes(x=x_vals,y=pmf_values)) +
geom_histogram(color = "blue") +
labs(x = "X Values",y = "Density", title = "Binomial pmf")
