library(lubridate)
weather_sub$datetime <- as.Date(ymd(weather_sub$datetime))
crimes_nondomestic$Date <- as.Date(crimes_nondomestic$Date)
head(crimes_nondomestic)
head(weather)
joined_data <- left_join(crimes_nondomestic,weather_sub, by = join_by(Date == datetime))
head(joined_data)
joined_data$preciptype[is.na(joined_data$preciptype)] <- "None"
head(joined_data)
table(joined_data$preciptype)
with_pg <- joined_data |>
mutate(precip_group = case_when(
str_detect(preciptype, "None") ~ "None",
str_detect(preciptype, "snow") ~ "Snow",
TRUE ~ "Rain"
))
sort(table(with_pg$`Primary Type`),decreasing = TRUE)[1:5]
top_five <- with_pg |>
filter(`Primary Type` == "NARCOTICS" | `Primary Type` == "THEFT" | `Primary Type` == "BATTERY" | `Primary Type` == "CRIMINAL DAMAGE" | `Primary Type` == "ROBBERY")
table(top_five$`Primary Type`)
head(with_pg)
daily_Crimes <- top_five %>%
group_by(Date, precip_group) %>%
summarise(total_crimes = n())
head(daily_Crimes)
ggplot(data = top_five, aes(x = precip_group, y = total_crimes)) +
geom_bar()
ggplot(data = daily_Crimes, aes(x = precip_group, y = total_crimes)) +
geom_bar()
ggplot(data = with_pg, aes(x = precip_group, y = total_crimes)) +
geom_bar()
head(with_pg)
